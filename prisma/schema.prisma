// El Buen Gusto - Restaurant POS de almuerzos
// NOTA: SQLite no soporta enums en Prisma, por eso los estados se guardan
// como String y se validan con las constantes de src/lib/roles.ts

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        Int      @id @default(autoincrement())
  nombre    String
  pin       String // 4 dígitos, único por rol (la búsqueda se hace por pin + rol)
  rol       String // ADMIN | MESERO | DOMICILIARIO
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())

  pedidos    Pedido[]
  cierres    CierreCaja[]
  domicilios Domicilio[] @relation("Domiciliario")

  @@unique([pin, rol]) // el mismo PIN puede repetirse entre roles distintos
}

model Producto {
  id        Int      @id @default(autoincrement())
  nombre    String
  tipo      String   // PROTEINA | PRINCIPIO | SOPA | BEBIDA | ADICIONAL
  precio    Int      @default(0) // COP enteros; 0 = incluido en el almuerzo
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())

  menuItems   MenuDiaItem[]
  pedidoItems PedidoItem[]
}

// Menú del día: que comidas se ofrecen HOY (proteínas, principios, sopas)
model MenuDia {
  id     Int     @id @default(autoincrement())
  fecha  String  @unique // yyyy-mm-dd
  activo Boolean @default(true)

  items     MenuDiaItem[]
  createdAt DateTime      @default(now())
}

// Porciones disponibles por producto en el menú del día (stock en tiempo real)
model MenuDiaItem {
  id             Int     @id @default(autoincrement())
  menuDiaId      Int
  menuDia        MenuDia @relation(fields: [menuDiaId], references: [id], onDelete: Cascade)
  productoId     Int
  producto       Producto @relation(fields: [productoId], references: [id])
  stockPorciones Int? // null = porciones ilimitadas
  vendidos       Int     @default(0)
  visible        Boolean @default(true) // false: el mesero no lo ve (se acabó antes de tiempo)

  @@unique([menuDiaId, productoId])
}

model Mesa {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique // identificador cualitativo (ej. "Ventana", "Para llevar · Juan")
  estado      String  @default("LIBRE") // LIBRE | OCUPADA | POR_PAGAR
  activa      Boolean @default(true) // false = oculta (sin pedidos nuevos)
  esDomicilio Boolean @default(false) // true = mesa virtual que agrupa los domicilios

  pedidos Pedido[]
}

model Pedido {
  id            Int      @id @default(autoincrement())
  mesaId        Int
  mesa          Mesa     @relation(fields: [mesaId], references: [id])
  meseroId      Int?
  mesero        Usuario? @relation(fields: [meseroId], references: [id])
  estado        String   @default("ENVIADO") // ENVIADO | EN_PREPARACION | PARCIAL_SERVIDO | SERVIDO | POR_PAGAR | COBRADO | CANCELADO
  paraLlevar    Boolean  @default(false) // domicilio: lleva icopor de $1.500
  observaciones String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items PedidoItem[]
  pagos Pago[]

  domicilio Domicilio?
}

model PedidoItem {
  id         Int      @id @default(autoincrement())
  pedidoId   Int
  pedido     Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id])
  tipo       String   // snapshot del tipo del producto al momento de ordenar
  cantidad   Int      @default(1)
  precio     Int?     // precio por unidad fijado al ordenar (almuerzo, bebidas...); null = usa producto.precio
  conSopa    Boolean? // aplica a la línea principal del almuerzo
  nota       String?  // ej: "Res sin cebolla"
}

model Pago {
  id        Int      @id @default(autoincrement())
  pedidoId  Int
  pedido    Pedido   @relation(fields: [pedidoId], references: [id])
  total     Int // COP enteros, sin decimales
  propina   Int      @default(0)
  metodo    String   // EFECTIVO | TARJETA | TRANSFERENCIA
  createdAt DateTime @default(now())
}

// Comprobante del cierre de caja del día (uno por fecha)
model CierreCaja {
  id              Int      @id @default(autoincrement())
  fecha           String   @unique // yyyy-mm-dd
  cerradoPorId    Int
  cerradoPor      Usuario  @relation(fields: [cerradoPorId], references: [id])
  totalPagos      Int // suma de pagos del día, sin propinas
  totalEfectivo   Int
  totalTarjeta    Int
  totalTransfer   Int
  totalPropinas   Int
  totalDomicilios Int // recaudo de domicilios entregados hoy (cobrado contra entrega)
  numeroPagos     Int
  numeroComandas  Int // comandas servidas o cobradas del día
  efectivoContado Int? // plata contada a mano (opcional); null = no se contó
  createdAt       DateTime @default(now())
}

model Configuracion {
  id    Int    @id @default(autoincrement())
  clave String @unique
  valor String
}

// Domicilio: entrega a la dirección del cliente. 1:1 con la comanda (Pedido),
// que se crea sobre la mesa virtual "Domicilios" para reutilizar stock y cobro.
model Domicilio {
  id             Int      @id @default(autoincrement())
  pedidoId       Int      @unique
  pedido         Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  cliente        String
  telefono       String
  direccion      String
  barrio         String?
  referencia     String?
  horaEntrega    String? // hora futura que dijo el cliente, ej: "las 12", "la 1 y media"
  // La misma hora en minutos desde medianoche (ej. 12:30 → 750) para poder
  // ordenar el tablero por hora de entrega; null = el cliente no la dijo.
  horaEntregaMinutos Int?
  estado         String   @default("PENDIENTE") // PENDIENTE | ASIGNADO | EN_CAMINO | ENTREGADO | NO_ENTREGADO | CANCELADO
  domiciliarioId Int?
  domiciliario   Usuario? @relation("Domiciliario", fields: [domiciliarioId], references: [id])
  cobradoMonto   Int? // total cobrado contra entrega (null = aún no cobrado)
  cobradoMetodo  String? // EFECTIVO | TARJETA | TRANSFERENCIA
  notaEntrega    String? // motivo de no entrega u observación del repartidor
  asignadoAt     DateTime?
  entregadoAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Entrada de WhatsApp: el mensaje crudo que llega (vía app forwarder del
// teléfono o pegado a mano) y su borrador parseado, antes de ser domicilio.
model EntradaWhatsapp {
  id          Int       @id @default(autoincrement())
  remitente   String    @default("") // título de la notificación: nombre del contacto
  telefono    String    @default("") // número del cliente (para responderle)
  texto       String
  // Guardia antiduplicados: hash de teléfono+texto; solo se usa contra la
  // ventana de los últimos minutos (una misma notificación reenviada no se
  // registra dos veces, pero el mismo texto de otro día entra normal)
  claveDedupe String
  estado      String    @default("NUEVO") // NUEVO | CONVERTIDO | DESCARTADO
  borrador    String? // JSON del borrador parseado la última vez
  armable     Boolean   @default(false)
  pedidoId    Int? // la comanda de domicilio que se creó de esta entrada
  recibidoAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([recibidoAt])
  @@index([estado])
  @@index([claveDedupe])
}
