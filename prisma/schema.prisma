// El Buen Gusto - Restaurant POS de almuerzos
// NOTA: SQLite no soporta enums en Prisma, por eso los estados se guardan
// como String y se validan con las constantes de src/lib/roles.ts

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        Int      @id @default(autoincrement())
  nombre    String
  pin       String // hash scrypt «scrypt:sal:hash» (o PIN de 4 dígitos legado aún sin migrar); la unicidad efectiva se compara con verificarPin (src/lib/pin.ts)
  rol       String // ADMIN | MESERO | DOMICILIARIO
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())

  pedidos    Pedido[]
  cierres    CierreCaja[]
  domicilios Domicilio[]  @relation("Domiciliario")

  // Módulos financieros (quién hizo qué)
  apartadosCreados    Apartado[]        @relation("ApartadoCreadoPor")
  apartadosCancelados Apartado[]        @relation("ApartadoCanceladoPor")
  cuentasCreadas      CuentaPorCobrar[] @relation("CuentaCreadaPor")
  abonosRegistrados   AbonoCuenta[]     @relation("AbonoRegistradoPor")
  gastosRegistrados   Gasto[]           @relation("GastoRegistradoPor")
  gastosAnulados      Gasto[]           @relation("GastoAnuladoPor")
  cuentasAnuladas     CuentaPorCobrar[] @relation("CuentaAnuladaPor")
  cuentasCondonadas   CuentaPorCobrar[] @relation("CuentaCondonadaPor")
  anticiposRegistrados AnticipoCliente[] @relation("AnticipoRegistradoPor")
  anticiposUsados      UsoAnticipo[]     @relation("AnticipoUsadoPor")
  fusionesHechas      FusionCliente[]   @relation("FusionesHechas")

  // Nómina (quién registró qué)
  nominaCreados           Empleado[]           @relation("NominaCreadoPor")
  contratosCreados        ContratoVersion[]    @relation("ContratoVersionCreadoPor")
  novedadesCreadas        NovedadNomina[]      @relation("NovedadCreadoPor")
  novedadesAprobadas      NovedadNomina[]      @relation("NovedadAprobadaPor")
  periodosCreados         PeriodoNomina[]      @relation("PeriodoCreadoPor")
  periodosCerrados        PeriodoNomina[]      @relation("PeriodoCerradoPor")
  jornadasNominaAbiertas  JornadaPagoNomina[]  @relation("JornadaNominaAbiertaPor")
  jornadasNominaCerradas  JornadaPagoNomina[]  @relation("JornadaNominaCerradaPor")
  liquidacionesCreadas    LiquidacionNomina[]  @relation("LiquidacionCreadoPor")
  liquidacionesAprobadas  LiquidacionNomina[]  @relation("LiquidacionAprobadaPor")
  pagosNominaRegistrados  PagoNomina[]         @relation("PagoNominaRegistradoPor")
  pagosPrestacionRegistrados PagoPrestacion[]  @relation("PagoPrestacionRegistradoPor")
  valesCreados            ValeNomina[]         @relation("ValeCreadoPor")
  valesAutorizados        ValeNomina[]         @relation("ValeAutorizadoPor")

  @@unique([pin, rol]) // el mismo PIN puede repetirse entre roles distintos
}

model Producto {
  id        Int      @id @default(autoincrement())
  nombre    String
  tipo      String // PROTEINA | PRINCIPIO | SOPA | BEBIDA | ADICIONAL
  precio    Int      @default(0) // COP enteros; 0 = incluido en el almuerzo
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())

  menuItems        MenuDiaItem[]
  pedidoItems      PedidoItem[]
  apartadoItems    ApartadoItem[]
  reservasApartado ApartadoReserva[] @relation("ReservasDeProducto")
  cuentaItems      CuentaPorCobrarItem[]
  vales            ValeNomina[]
}

// Menú del día: que comidas se ofrecen HOY (proteínas, principios, sopas)
model MenuDia {
  id     Int     @id @default(autoincrement())
  fecha  String  @unique // yyyy-mm-dd
  activo Boolean @default(true)

  items     MenuDiaItem[]
  createdAt DateTime      @default(now())
}

// Porciones disponibles por producto en el menú del día (stock en tiempo real)
model MenuDiaItem {
  id             Int      @id @default(autoincrement())
  menuDiaId      Int
  menuDia        MenuDia  @relation(fields: [menuDiaId], references: [id], onDelete: Cascade)
  productoId     Int
  producto       Producto @relation(fields: [productoId], references: [id])
  stockPorciones Int? // null = porciones ilimitadas
  vendidos       Int      @default(0)
  visible        Boolean  @default(true) // false: el mesero no lo ve (se acabó antes de tiempo)

  // Precio especial de ESTE día (COP): es como se cobran los especiales del
  // domingo (asados $24.000, gallina $17.000, pescados $25.000) aunque el
  // producto corra toda la semana al precio del almuerzo corriente.
  // null = hoy rige el precio normal (con sopa $13.000 · bandeja $12.000,
  // o el precio propio del producto si lo tiene).
  precioEspecial Int?

  reservasApartado ApartadoReserva[] // porciones comprometidas por apartados pendientes

  @@unique([menuDiaId, productoId])
}

model Mesa {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique // identificador cualitativo (ej. "Ventana", "Para llevar · Juan")
  estado      String  @default("LIBRE") // LIBRE | OCUPADA | POR_PAGAR
  activa      Boolean @default(true) // false = oculta (sin pedidos nuevos)
  esDomicilio Boolean @default(false) // true = mesa virtual que agrupa los domicilios
  esApartado  Boolean @default(false) // true = mesa virtual sobre la que nace la comanda de un apartado

  pedidos Pedido[]
}

model Pedido {
  id            Int      @id @default(autoincrement())
  // Consecutivo visible del día. El id nunca se reutiliza: este número sí
  // vuelve a 1 tras el cierre, sin romper enlaces, facturas o auditoría.
  fechaConsecutivo String?
  consecutivoDia   Int?
  mesaId        Int
  mesa          Mesa     @relation(fields: [mesaId], references: [id])
  meseroId      Int?
  mesero        Usuario? @relation(fields: [meseroId], references: [id])
  estado        String   @default("ENVIADO") // ENVIADO | EN_PREPARACION | PARCIAL_SERVIDO | SERVIDO | POR_PAGAR | COBRADO | CANCELADO
  paraLlevar    Boolean  @default(false) // domicilio: lleva icopor de $1.500
  observaciones String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items PedidoItem[]
  pagos Pago[]

  domicilio Domicilio?
  apartado  Apartado?  @relation("ApartadoEntregado") // comanda creada al entregar un apartado

}

model PedidoItem {
  id         Int      @id @default(autoincrement())
  pedidoId   Int
  pedido     Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  // null = el producto fue ELIMINADO definitivamente del catálogo: la foto
  // productoNombre conserva el nombre de la venta y la línea no desaparece
  productoId Int?
  producto   Producto? @relation(fields: [productoId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  productoNombre String? // FOTO histórica del nombre del producto al momento de vender
  tipo       String // snapshot del tipo del producto al momento de ordenar
  cantidad   Int      @default(1)
  precio     Int? // precio por unidad fijado al ordenar (almuerzo, bebidas...); null = usa producto.precio
  conSopa    Boolean? // aplica a la línea principal del almuerzo
  nota       String? // ej: "Res sin cebolla"
  grupo      Int      @default(0) // 0 = extra, 1+ = índice del plato en la comanda

  cuentaItems CuentaPorCobrarItem[] // fotos de esta línea en deudas (fiados)
}

model Pago {
  id          Int      @id @default(autoincrement())
  pedidoId    Int
  pedido      Pedido   @relation(fields: [pedidoId], references: [id])
  total       Int // COP enteros, sin decimales
  propina     Int      @default(0)
  metodo      String // EFECTIVO | TARJETA | TRANSFERENCIA
  // ¿Con cuánto dinero entregó el cliente y cuánto se le devolvió? Solo
  // aplican al efectivo; null = pago exacto o con otro método.
  montoPagado Int?
  vueltas     Int?
  createdAt   DateTime @default(now())
}

// Comprobante del cierre de caja del día (uno por fecha)
model CierreCaja {
  id              Int      @id @default(autoincrement())
  fecha           String   @unique // yyyy-mm-dd
  cerradoPorId    Int
  cerradoPor      Usuario  @relation(fields: [cerradoPorId], references: [id])
  totalPagos      Int // suma de pagos del día, sin propinas
  totalEfectivo   Int
  totalTarjeta    Int
  totalTransfer   Int
  totalPropinas   Int
  propinasEfectivo Int?
  efectivoEsperado Int?
  totalDomicilios Int // recaudo de domicilios entregados hoy (cobrado contra entrega)
  numeroPagos     Int
  numeroComandas  Int // comandas servidas o cobradas del día
  efectivoContado Int? // plata contada a mano (opcional); null = no se contó
  createdAt       DateTime @default(now())

  // —— Fotografía financiera del día (solo en cierres nuevos; null = un cierre
  // anterior cuyas secciones se calculan en vivo para mirar) ——
  numeroDomicilios       Int? // domicilios registrados hoy
  numeroApartados        Int? // apartados registrados hoy
  numeroApartadosEntrega Int? // apartados entregados hoy
  numeroAbonos           Int? // abonos/pagos de deudas recibidos hoy
  abonosTotal            Int? // dinero RECIBIDO por deudas hoy (¡no es venta!)
  abonosEfectivo         Int?
  abonosTarjeta          Int?
  abonosTransfer         Int?
  numeroGastos           Int? // gastos no anulados registrados hoy
  totalGastosCaja        Int? // gastos pagados desde caja (todos los métodos)
  gastosCajaEfectivo     Int? // de esos, los pagados con dinero FÍSICO de caja
  totalGastosExternos    Int? // auditados, no tocan la caja
  cxcCreadasCantidad     Int? // deudas creadas hoy
  cxcCreadasValor        Int?
  cxcTotalPendiente      Int? // saldo por cobrar AL MOMENTO DEL CIERRE
  cxcSnapshot            String? // JSON: lista de pendientes al cierre (cliente/concepto/fecha/valor/abonado/saldo)
  cxcCondonadasCantidad  Int? // deudas condonadas HOY (nuevo desde 2026-11-04)
  cxcCondonadasValor     Int? // saldo perdonado hoy (NO es ingreso ni pago)
}

model Configuracion {
  id    Int    @id @default(autoincrement())
  clave String @unique
  valor String
}

// Domicilio: entrega a la dirección del cliente. 1:1 con la comanda (Pedido),
// que se crea sobre la mesa virtual "Domicilios" para reutilizar stock y cobro.
model Domicilio {
  id                 Int       @id @default(autoincrement())
  // Numeración propia de domicilios del día; separada de la comanda.
  fechaConsecutivo   String?
  consecutivoDia     Int?
  pedidoId           Int       @unique
  pedido             Pedido    @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  cliente            String
  telefono           String
  direccion          String
  barrio             String?
  referencia         String?
  horaEntrega        String? // hora futura que dijo el cliente, ej: "las 12", "la 1 y media"
  // La misma hora en minutos desde medianoche (ej. 12:30 → 750) para poder
  // ordenar el tablero por hora de entrega; null = el cliente no la dijo.
  horaEntregaMinutos Int?
  estado             String    @default("PENDIENTE") // PENDIENTE | ASIGNADO | EN_CAMINO | ENTREGADO | NO_ENTREGADO | CANCELADO
  domiciliarioId     Int?
  domiciliario       Usuario?  @relation("Domiciliario", fields: [domiciliarioId], references: [id])
  cobradoMonto       Int? // total cobrado contra entrega (null = aún no cobrado)
  cobradoMetodo      String? // EFECTIVO | TARJETA | TRANSFERENCIA
  notaEntrega        String? // motivo de no entrega u observación del repartidor
  asignadoAt         DateTime?
  entregadoAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Cliente registrado del módulo Clientes (null = domicilio anterior sin vincular)
  clienteId         Int?
  clienteRegistrado Cliente? @relation(fields: [clienteId], references: [id])

}

// Una fila por jornada de caja. Al abrir una fecha nueva se crea con los
// contadores en 1; el cierre bloquea nuevos pedidos para esa fecha.
model ConsecutivoDiario {
  fecha              String @id // yyyy-mm-dd
  siguientePedido    Int    @default(1)
  siguienteDomicilio Int    @default(1)
  updatedAt          DateTime @updatedAt
}

// ════════ Módulo de clientes ════════
// Personas y domiciliarias registradas. No lleva claves únicas estrictas:
// la no-duplicación se comparte en el app (mismo teléfono normalizado,
// o mismo nombre en minúscula para los que van sin teléfono), que es como
// agrupa el historial de domicilios.
model Cliente {
  id               Int      @id @default(autoincrement())
  nombre           String
  telefono         String   @default("") // puede ir vacío (clientes «solo el nombre»)
  direccion        String   @default("")
  barrio           String?
  observaciones    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  // Versiones normalizadas para búsqueda en BD (sin límite de 300):
  // nombre sin acentos/espacios simples y teléfono en solo dígitos,
  // actualizadas al crear/editar/fusionar.
  nombreBusqueda   String   @default("")
  telefonoBusqueda String   @default("")

  domicilios          Domicilio[]
  apartados           Apartado[]
  cuentas             CuentaPorCobrar[]
  anticipos           AnticipoCliente[]
  fusionesComoDestino FusionCliente[]   @relation("FusionesComoDestino")
}

// ════════ Módulo de apartados ════════
// Almuerzos/pedidos reservados por un cliente para recoger después.
// El total queda CONGELADO al apartar; al entregar nace la comanda (Pedido,
// sobre la mesa virtual «Apartados») con los precios congelados, y según el
// caso un Pago (pagada, venta normal) o una CuentaPorCobrar (fiada, deuda).
// Nunca se cuenta doble: el dinero entra o por Pago, o después por abonos.
model Apartado {
  id                 Int              @id @default(autoincrement())
  clienteId          Int
  cliente            Cliente          @relation(fields: [clienteId], references: [id])
  estado             String           @default("PENDIENTE") // PENDIENTE | ENTREGADO | CANCELADO
  // Cómo se entrega: para recoger (llama a precios para llevar y siempre
  // sale con empaque) o para servir EN MESA del salón. Se congeló al apartar.
  paraLlevar         Boolean          @default(false)
  fechaEntrega       String? // yyyy-mm-dd deseado (opcional; hoy si no se dijo)
  horaEntrega        String? // "12:30 p. m." tal como lo dijo el cliente
  horaEntregaMinutos Int? // «12:30» → 750, para ordenar la fila
  total              Int              @default(0) // COP congelado al apartar
  observaciones      String?
  pedidoId           Int?             @unique // comanda registrada al entregar
  pedido             Pedido?          @relation("ApartadoEntregado", fields: [pedidoId], references: [id])
  cuentaId           Int?             @unique // deuda creada si se entregó sin pagar
  cuenta             CuentaPorCobrar? @relation("ApartadoOrigen", fields: [cuentaId], references: [id])
  createdById        Int
  creadoPor          Usuario          @relation("ApartadoCreadoPor", fields: [createdById], references: [id])
  entregadoAt        DateTime?
  // Auditoría de cancelación (quién/cuándo/por qué; el motivo es opcional)
  canceladoById      Int?
  canceladoPor       Usuario?         @relation("ApartadoCanceladoPor", fields: [canceladoById], references: [id])
  canceladoAt        DateTime?
  canceladoMotivo    String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  items    ApartadoItem[]
  reservas ApartadoReserva[] // porciones reservadas mientras está PENDIENTE
}

// Línea de un apartado: nombre/precio CONGELADOS (el menú de aquel día puede
// cambiar antes de la entrega; el cliente pagó lo pactado)
model ApartadoItem {
  id         Int       @id @default(autoincrement())
  apartadoId Int
  apartado   Apartado  @relation(fields: [apartadoId], references: [id], onDelete: Cascade)
  productoId Int? // null = ítem narrado a mano que no está en el catálogo
  producto   Producto? @relation(fields: [productoId], references: [id])
  nombre     String
  tipo       String // snapshot del tipo (ALMUERZO, PROTEINA, BEBIDA, ADICIONAL, OTRO)
  cantidad   Int       @default(1)
  precio     Int       @default(0) // COP por unidad, congelado al apartar
  conSopa    Boolean? // solo en almuerzos: para rearmar el plato al entregar
  nota       String? // «sin cebolla», «toalla aparte»…
  detalle    String? // JSON del almuerzo completo (sopa, principios, ensaladas, adicionales con sus ids/nombres congelados); legacy = null

  reservas ApartadoReserva[]
}

// Un apartado PENDIENTE compromete porciones del menú de su fecha de entrega:
// un renglón por cada componentes con stock (proteína, principios, ensalada y
// sopa de cada almuerzo). Al entregar se convierten en consumo real (vendidos),
// al cancelar/editar se liberan. La disponibilidad del menú es
// stock − vendidos − reservados. Si borran el ítem del menú, la reserva pierde
// su objetivo (menuDiaItemId null) y la entrega vuelve a verificar el men vivo.
model ApartadoReserva {
  id             Int          @id @default(autoincrement())
  apartadoId     Int
  apartado       Apartado     @relation(fields: [apartadoId], references: [id], onDelete: Cascade)
  apartadoItemId Int
  apartadoItem   ApartadoItem @relation(fields: [apartadoItemId], references: [id], onDelete: Cascade)
  menuDiaItemId  Int?
  menuDiaItem    MenuDiaItem? @relation(fields: [menuDiaItemId], references: [id])
  productoId     Int?
  producto       Producto?    @relation("ReservasDeProducto", fields: [productoId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  productoNombre String? // FOTO del nombre reservado (sobrevive a borrar el producto)
  cantidad       Int
}

// Auditoría de fusiones de clientes: los datos del origen quedan copiados aquí
// porque la ficha origen se elimina físicamente. No toca importes ni caja: solo
// reasigna domicilios/apartados/cuentas al cliente destino.
model FusionCliente {
  id             Int      @id @default(autoincrement())
  origenId       Int // id de la ficha eliminada (sin FK: ya no existe)
  origenNombre   String
  origenTelefono String
  destinoId      Int
  destino        Cliente  @relation("FusionesComoDestino", fields: [destinoId], references: [id])
  domicilios     Int      @default(0) // movidos
  apartados      Int      @default(0)
  cuentas        Int      @default(0)
  saldoMovido    Int      @default(0) // saldo pendiente que viajó (informativo)
  createdById    Int
  hechoPor       Usuario  @relation("FusionesHechas", fields: [createdById], references: [id])
  createdAt      DateTime @default(now())
}

// ════════ Cuentas por cobrar (fiados) ════════
// Lo que debe un cliente. Una deuda registrada NO es dinero recibido: no
// toca los ingresos ni el efectivo; solo cuando el abono llega entra como
// dinero el día en que se recibe (y por separado de las ventas).
model CuentaPorCobrar {
  id            Int       @id @default(autoincrement())
  clienteId     Int
  cliente       Cliente   @relation(fields: [clienteId], references: [id])
  concepto      String // motivo/detalle («2 almuerzos del día»…)
  valorOriginal Int // COP de la deuda al momento de crearla
  pagado        Int       @default(0) // suma de los abonos (saldo = original − pagado)
  estado        String    @default("PENDIENTE") // PENDIENTE | PAGADA | ANULADA | CONDONADA
  // Condonación del saldo restante: el restaurante perdona lo que falta. La
  // condonación NO es dinero recibido; los abonos previos siguen siendo
  // ingresos de caja. Saldo final = original − pagado − saldoCondonado = 0.
  saldoCondonado Int       @default(0)
  condonadoById  Int?
  condonadoPor   Usuario?  @relation("CuentaCondonadaPor", fields: [condonadoById], references: [id])
  condonadoAt    DateTime?
  condonadoMotivo String?
  pedidoId      Int? // origen opcional (pedido, que puede ser de domicilio)
  createdById   Int
  creadoPor     Usuario   @relation("CuentaCreadaPor", fields: [createdById], references: [id])
  anuladaById   Int?
  anuladaPor    Usuario?  @relation("CuentaAnuladaPor", fields: [anuladaById], references: [id])
  anuladaAt     DateTime?
  anuladaMotivo String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  apartados Apartado[]    @relation("ApartadoOrigen")
  abonos    AbonoCuenta[]
  items     CuentaPorCobrarItem[]
}

// Pago total o parcial de una deuda. Nunca se borra: al llegar el saldo a
// cero la cuenta pasa a PAGADA y queda en el historial para auditoría.
model AbonoCuenta {
  id            Int             @id @default(autoincrement())
  cuentaId      Int
  cuenta        CuentaPorCobrar @relation(fields: [cuentaId], references: [id])
  monto         Int // COP abonado en este pago
  metodo        String // EFECTIVO | TARJETA | TRANSFERENCIA
  nota          String?
  usuarioId     Int
  registradoPor Usuario         @relation("AbonoRegistradoPor", fields: [usuarioId], references: [id])
  createdAt     DateTime        @default(now())
}

// Saldo a favor que un cliente deja para consumos futuros. A diferencia de
// un fiado, aquí el dinero ya fue recibido: cada uso descuenta el saldo, pero
// el registro original y sus movimientos nunca se borran.
model AnticipoCliente {
  id            Int      @id @default(autoincrement())
  clienteId     Int
  cliente       Cliente  @relation(fields: [clienteId], references: [id])
  concepto      String
  valorOriginal Int
  usado         Int      @default(0)
  estado        String   @default("VIGENTE") // VIGENTE | AGOTADO | ANULADO
  metodo        String   // EFECTIVO | TARJETA | TRANSFERENCIA
  createdById   Int
  creadoPor     Usuario  @relation("AnticipoRegistradoPor", fields: [createdById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  usos UsoAnticipo[]

  @@index([clienteId, estado])
}

// Cada descuento conserva qué se entregó o consumió el cliente. Es un
// movimiento auditable del saldo a favor; no se elimina al agotarse.
model UsoAnticipo {
  id          Int              @id @default(autoincrement())
  anticipoId  Int
  anticipo    AnticipoCliente  @relation(fields: [anticipoId], references: [id], onDelete: Cascade)
  monto       Int
  concepto    String
  usuarioId   Int
  registradoPor Usuario         @relation("AnticipoUsadoPor", fields: [usuarioId], references: [id])
  createdAt   DateTime         @default(now())

  @@index([anticipoId])
}

// Desglose de artículos de una deuda: la FOTO de cada línea del pedido que se
// fió, con el precio congelado (se lee con precioUnitarioItem como en caja).
// Deuda ≠ ingreso: esta foto informa qué se llevó el cliente, nunca cuánta
// caja entró. pedidoItemId enlaza la línea concreta de la comanda; si el
// pedido se anula/borra la foto sigue completa (SetNull). El precio NUNCA se
// recalcula: es el congelado al fiar.
model CuentaPorCobrarItem {
  id           Int             @id @default(autoincrement())
  cuentaId     Int
  cuenta       CuentaPorCobrar @relation(fields: [cuentaId], references: [id], onDelete: Cascade)
  pedidoItemId Int?
  pedidoItem   PedidoItem?     @relation(fields: [pedidoItemId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  productoId   Int?
  producto     Producto?       @relation(fields: [productoId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  grupo        Int       @default(0) // 0 = extra, 1+ = plato de la comanda
  tipo         String // snapshot del tipo de la línea
  nombre       String // snapshot del nombre (productoNombre de la línea)
  cantidad     Int
  precio       Int // COP por unidad congelado al fiar
  conSopa      Boolean?
  nota         String?
  createdAt    DateTime  @default(now())

  @@index([cuentaId])
}

// ════════ Gastos ════════
// Lo que el restaurante gasta. Con origen CAJA descontar del efectivo (solo
// el pagado con EFECTIVO); con origen EXTERNO queda auditado sin tocar caja.
// Anular ≠ borrar: se marca anulado con quién/cuándo/por qué, el registro
// queda para auditoría.
model Gasto {
  id            Int       @id @default(autoincrement())
  descripcion   String
  categoria     String // constante CATEGORIA_GASTO (roles.ts): INGREDIENTES…
  valor         Int // COP
  metodo        String // EFECTIVO | TARJETA | TRANSFERENCIA (cómo se pagó)
  origen        String // CAJA (toca el efectivo si es efectivo) | EXTERNO
  usuarioId     Int
  registradoPor Usuario   @relation("GastoRegistradoPor", fields: [usuarioId], references: [id])
  observaciones String?
  anulado       Boolean   @default(false)
  anuladoById   Int?
  anuladoPor    Usuario?  @relation("GastoAnuladoPor", fields: [anuladoById], references: [id])
  anuladoAt     DateTime?
  anuladoMotivo String?
  createdAt     DateTime  @default(now())
}

// ════════ Nómina ════════
// Todo el conocimiento legal vive en la tabla ParametroLaboral CON VIGENCIA:
// una modificación normativa entra como una fila nueva desde su fecha y las
// liquidaciones ya cerradas guardan la FOTO de los parámetros que usaron.
// El dinero va EN COP ENTEROS (nunca flotantes); los porcentajes van en
// DIEZMILÉSIMAS (100.00 % = 1_000_000) y los tiempos en MINUTOS.

// Parámetro normativo con vigencia (SMMLV, auxilio, recargos, aportes…)
model ParametroLaboral {
  id             Int       @id @default(autoincrement())
  clave          String // SALARIO_MINIMO, AUXILIO_TRANSPORTE, RECARGO_NOCTURNO…
  valor          Int // COP salariales / redondeado a COP; % en diezmilésimas
  unidad         String // COP | PORCENTAJE(diezmilésimas) | MINUTOS
  vigenciaDesde  DateTime
  vigenciaHasta  DateTime? // null = sin fecha de fin declarada
  descripcion    String
  fuente         String // norma y artículo («Decreto 1470 de 2025», «Art 161 CST + Ley 2466 de 2025»)
  pendienteVerificar Boolean @default(false) // marca de «día exacto por confirmar»
  nota           String?
  categoria      String // INDICADOR (salarios/auxilio) | RECARGO | APOS_TRABAJADOR | APOS_EMPRESA | JORNADA
  createdAt      DateTime  @default(now())

  @@unique([clave, vigenciaDesde])
  @@index([clave, vigenciaDesde])
}

// Calendario de festivos (ley Emiliani): marca fechas de descanso obligatorio
model Festivo {
  fecha  String @id // yyyy-mm-dd
  nombre String
  anio   Int

  @@index([anio])
}

// Trabajador. NO se borra físicamente: desactivar (estado INACTIVO) conserva
// historial de liquidaciones/pagos para siempre.
model Empleado {
  id              Int       @id @default(autoincrement())
  nombre          String // nombres
  apellidos       String
  documentoTipo   String // CC | CE | TI | PE | OTRO
  documentoNumero String @unique
  telefono        String?
  direccion       String?
  cargo           String // «Cocinero», «Mesero»…
  fechaIngreso    DateTime
  fechaRetiro     DateTime? // al desactivar (o retiro pactado)
  estado          String    @default("ACTIVO") // ACTIVO | INACTIVO
  estadoMotivo    String? // por qué se desactivó (auditoría)
  // Seguridad social (informativa: los fondos se nombran o se SIEMPRE
  // consultan manualmente; el sistema calcula PORCENTAJES por parámetro)
  epsNombre        String?
  fondoPensionName String? // fondo de pensión (no exige nombre el cálculo)
  arpClase         Int     @default(2) // clase de riesgo laboral I..VI (tarifa ARP)
  // Contrato VIGENTE: la verdad operativa. Los cambios salariales NO
  // editan estas columnas: nacen una ContratoVersion nueva (historial),
  // y aquí queda espejado lo vigente para consultas rápidas.
  modalidad        String  @default("LABORAL") // LABORAL (contrato) | INDEPENDIENTE (prestación servicios)
  remuneracion     String  @default("MENSUAL") // MENSUAL | DIARIO | HORARIO
  salarioMensual   Int     @default(0) // COP (también resume diario×30 o hora×factor; el detalle va en la versión)
  salarioDiario    Int     @default(0) // para DIARIO: COP por día laborado
  valorHora        Int     @default(0) // para HORARIO: COP por hora
  jornadaSemanalMinutos Int @default(2640) // 44 h (2026 hasta 14 jul); 42 h = 2520 desde 15 jul
  periodicidadPago String  @default("QUINCENAL") // QUINCENAL | MENSUAL
  diaDescanso      Int     @default(0) // 0=domingo … 6=sábado: descanso obligatorio semanal
  auxilioTransporte Boolean @default(false) // auto: base ≤ 2 SMMLV (se recalcula al cambiar salario)
  metodoPago       String  @default("EFECTIVO") // EFECTIVO | TRANSFERENCIA | OTRO
  horaLimiteEntradaMinutos Int? // umbral de llegada tarde (min desde medianoche; null = sin control)
  creadoById       Int
  creadoPor        Usuario @relation("NominaCreadoPor", fields: [creadoById], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  contratoVersiones ContratoVersion[]
  novedades         NovedadNomina[]
  liquidaciones     LiquidacionNomina[]
  pagosPrestaciones PagoPrestacion[]
  vales             ValeNomina[]
  creditos          CreditoNomina[]

  @@index([estado])
}

// Historial contractual/salarial: una fila por cambio (aumento, cambio de
// modalidad, cambio de jornada). Las liquidaciones guardan su propia copia,
// así que editar una versión nueva JAMÁS reescribe nóminas antiguas.
model ContratoVersion {
  id                 Int       @id @default(autoincrement())
  empleadoId         Int
  empleado           Empleado  @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  desde              DateTime // fecha desde la que aplica
  hasta              DateTime? // null = sigue vigente (se cierra al registrar el cambio siguiente)
  modalidad          String // LABORAL | INDEPENDIENTE
  remuneracion       String // MENSUAL | DIARIO | HORARIO
  salarioMensual     Int
  salarioDiario      Int
  valorHora          Int
  jornadaSemanalMinutos Int
  periodicidadPago   String
  diaDescanso        Int
  auxilioTransporte  Boolean
  metodoPago         String
  motivo             String // «aumento», «contrato nuevo»…
  creadoById         Int
  creadoPor          Usuario   @relation("ContratoVersionCreadoPor", fields: [creadoById], references: [id])
  createdAt          DateTime  @default(now())

  @@index([empleadoId, desde])
}

// Novedad que modifica una liquidación (comisiones, ausencias, permisos…).
// El pago interno no calcula horas extras ni recargos por asistencia.
model NovedadNomina {
  id           Int      @id @default(autoincrement())
  empleadoId   Int
  empleado     Empleado @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  fecha        String   // yyyy-mm-dd (o inicio del concepto)
  dias         Int?     // ausencias/permisos/vacaciones (días de salario)
  valor        Int?     // comisión/bonificación/descuento (COP; DESCUENTO resta)
  descripcion  String
  tipo         String // COMISION | BONIFICACION | AUSENCIA | INCAPACIDAD |
                      // PERMISO_REMUNERADO | PERMISO_NO_REMUNERADO | VACACIO
  estado       String   @default("PENDIENTE") // PENDIENTE | APROBADA | RECHAZADA
  liquidacionId Int?    // set al incorporarse a una liquidación: NO se cuenta €. una
  // Auditoría de aprobación
  aprobadoById  Int?
  aprobadoPor   Usuario? @relation("NovedadAprobadaPor", fields: [aprobadoById], references: [id])
  aprobadoAt    DateTime?
  rechazoMotivo String?
  creadoById    Int
  creadoPor     Usuario  @relation("NovedadCreadoPor", fields: [creadoById], references: [id])
  createdAt     DateTime @default(now())
  creditoId    Int?
  credito      CreditoNomina? @relation(fields: [creditoId], references: [id])

  @@index([empleadoId, estado])
}

// Préstamo pactado: cada cuota es una deducción con fecha elegida.
model CreditoNomina {
  id         Int @id @default(autoincrement())
  empleadoId Int
  empleado   Empleado @relation(fields: [empleadoId], references: [id])
  monto      Int
  motivo     String
  metodo     String @default("TRANSFERENCIA")
  gastoId    Int?
  creadoById Int
  createdAt  DateTime @default(now())
  cuotas     NovedadNomina[]
}

// Período de nómina: QUINCENAL (1–15 / 16–fin) o MENSUAL (calendario).
model PeriodoNomina {
  id          Int     @id @default(autoincrement())
  fechaDesde  String  // yyyy-mm-dd inclusivo
  fechaHasta  String  // yyyy-mm-dd inclusivo
  fechaPagoPrevista String?
  tipo        String  // QUINCENAL | MENSUAL | CICLOS (cortes 7/14/21/fin de mes)
  estado      String  @default("ABIERTO") // ABIERTO | CERRADO
  cerradoById Int?
  cerradoPor  Usuario? @relation("PeriodoCerradoPor", fields: [cerradoById], references: [id])
  cerradoAt   DateTime?
  creadoById  Int
  creadoPor   Usuario @relation("PeriodoCreadoPor", fields: [creadoById], references: [id])
  createdAt   DateTime @default(now())

  liquidaciones LiquidacionNomina[]
  vales         ValeNomina[]

  @@unique([fechaDesde, fechaHasta])
}

// Una jornada es la sesión operativa en la que el administrador entrega los
// pagos del equipo. No reemplaza los rangos internos de cada empleado: los
// agrupa para impedir que se creen pagos nuevos fuera de una jornada abierta.
model JornadaPagoNomina {
  id           Int      @id @default(autoincrement())
  fecha        String   // día escogido por el administrador para pagar
  estado       String   @default("ABIERTA") // ABIERTA | CERRADA
  // "ABIERTA" es único mientras la sesión vive; al cerrarla queda null.
  // Así nunca pueden coexistir dos jornadas de pago activas.
  claveAbierta String?  @unique
  abiertoById  Int
  abiertoPor   Usuario  @relation("JornadaNominaAbiertaPor", fields: [abiertoById], references: [id])
  cerradoById  Int?
  cerradoPor   Usuario? @relation("JornadaNominaCerradaPor", fields: [cerradoById], references: [id])
  cerradoAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  liquidaciones LiquidacionNomina[]

  @@index([fecha])
  @@index([estado])
}

// Liquidación de UN empleado en UN período. Es una FOTO: conceptos, contrato
// y parámetros quedan congelados al crearse; una APROBADA no se edita nunca
// (correcciones por liquidación nueva o anulación auditable).
model LiquidacionNomina {
  id          Int     @id @default(autoincrement())
  periodoId   Int
  periodo     PeriodoNomina @relation(fields: [periodoId], references: [id], onDelete: Cascade)
  jornadaId   Int?
  jornada     JornadaPagoNomina? @relation(fields: [jornadaId], references: [id])
  empleadoId  Int
  empleado    Empleado @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  estado      String  @default("BORRADOR") // BORRADOR | APROBADA | (cerrada por su período)
  diasTrabajados Int  @default(0)
  // FOTO contractual usada (sin ella el aumento cambiaría el pasado)
  contratoFoto  String // JSON ContratoVersion
  parametrosFoto String // JSON ParametroLaboral[] usados en el cálculo
  novedadesFoto  String? // JSON resumen de novedades incorporadas

  // Devengados
  salarioBase     Int @default(0) // proporcional a los días del período
  horasExtraRecargos Int @default(0) // reservado: el pago interno no calcula recargos
  comisionesBonos Int @default(0)
  auxilioTransporte Int @default(0)
  otrosDevengados Int @default(0) // permisos remunerados días de salario etc.
  totalDevengado  Int @default(0)
  // Deducciones del TRABAJADOR
  deduccionSalud  Int @default(0)
  deduccionPension Int @default(0)
  otrosDescuentos Int @default(0)
  totalDeducciones Int @default(0)
  netoAPagar      Int @default(0)
  pagado          Int @default(0)
  estadoPago      String @default("PENDIENTE") // PENDIENTE | PARCIALMENTE | PAGADO
  // Aportes del EMPLEADOR (costo informativo: NUNCA se restan del neto)
  empresaSalud    Int @default(0)
  empresaPension  Int @default(0)
  empresaRiesgos  Int @default(0)
  empresaCaja     Int @default(0)
  costoEmpleador  Int @default(0)
  // Causación de prestaciones del período (acumulan al empleado)
  prestacionPrima     Int @default(0)
  prestacionCesantias Int @default(0)
  prestacionIntereses Int @default(0)
  prestacionVacaciones Int @default(0)
  // Auditoría
  creadoById Int
  creadoPor  Usuario @relation("LiquidacionCreadoPor", fields: [creadoById], references: [id])
  aprobadoById Int?
  aprobadoPor Usuario? @relation("LiquidacionAprobadaPor", fields: [aprobadoById], references: [id])
  aprobadoAt DateTime?
  notas      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  conceptos LiquidacionConcepto[]
  pagos     PagoNomina[]
  vales     ValeNomina[]

  @@unique([periodoId, empleadoId])
  @@index([empleadoId])
  @@index([jornadaId])
}

// Cada renglón del comprobante (devengado, deducción, aporte, prestación)
model LiquidacionConcepto {
  id            Int     @id @default(autoincrement())
  liquidacionId Int
  liquidacion   LiquidacionNomina @relation(fields: [liquidacionId], references: [id], onDelete: Cascade)
  tipo          String // DEVENGADO | DEDUCCION | EMPRESA | PRESTACION
  clave         String // SALARIO, HORA_EXTRA_D, SALUD, PRIMA…
  etiqueta      String
  valor         Int // COP (deducciones guardan el valor POSITIVO; el negativo se	pinta)
  detalle       String?
  @@index([liquidacionId])
}

// Pago real de una liquidación (parcial o total). Dinero que SALÉ: entra a
// Caja como Gasto(NOMINA) el mismo instante si es EFECTIVO; transferencia
// toca nómina pero no el efectivo físico.
model PagoNomina {
  id            Int    @id @default(autoincrement())
  liquidacionId Int
  liquidacion   LiquidacionNomina @relation(fields: [liquidacionId], references: [id], onDelete: Cascade)
  monto         Int // COP entregado
  fecha         DateTime @default(now())
  metodo        String // EFECTIVO | TRANSFERENCIA | OTRO
  referencia    String? // # de transferencia, mostrado…
  observaciones String?
  gastoId       Int? // Gasto generado (solo EFECTIVO): vínculo Nómina ↔ Caja
  usuarioId     Int
  registradoPor Usuario @relation("PagoNominaRegistradoPor", fields: [usuarioId], references: [id])
  createdAt     DateTime @default(now())

  @@index([liquidacionId])
}

// Pago de una prestación (prima de junio, cesantías…): causa PENDIENTE hasta
// efectivamente entregarse — el cálculo no significa pagado.
model PagoPrestacion {
  id          Int      @id @default(autoincrement())
  empleadoId  Int
  empleado    Empleado @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  concepto    String   // PRIMA | CESANTIAS | INTERESES_CESANTIAS | VACACIONES
  monto       Int
  fecha       DateTime @default(now())
  metodo      String // EFECTIVO | TRANSFERENCIA | OTRO
  referencia  String?
  observaciones String?
  gastoId     Int? // solo si EFECTIVO (egreso real a Caja)
  usuarioId   Int
  registradoPor Usuario @relation("PagoPrestacionRegistradoPor", fields: [usuarioId], references: [id])
  createdAt   DateTime @default(now())

  @@index([empleadoId, concepto])
}

// Vale de consumo: producto entregado a un empleado A CUENTA de su sueldo.
// Se registra EXPRESAMENTE (jamás se descuentan compras de un Cliente).
// El precio queda congelado al entregar; el nombre del producto también (el
// vale sobrevive aunque el producto cambie o se retire del catálogo).
// Estados: PENDIENTE (registrado) → AUTORIZADO (aprobado por el dueño) →
// DESCONTADO (marcado al liquidarse el ciclo, con liquidacionId: no se
// cuenta dos veces) · ANULADO (con motivo, conservando el original).
model ValeNomina {
  id             Int      @id @default(autoincrement())
  empleadoId     Int
  empleado       Empleado @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  productoId     Int? // la fila del catálogo usada al registrar (informativa)
  producto       Producto? @relation(fields: [productoId], references: [id])
  productoNombre String // nombre CONGELADO al entregar
  cantidad       Int      @default(1)
  precioUnitario Int // COP registrado al entregar (congelado)
  total          Int // cantidad × precioUnitario
  fecha          String // yyyy-mm-dd de la entrega
  observaciones  String?
  cicloId        Int? // PeriodoNomina al que se asigna el descuento
  ciclo          PeriodoNomina? @relation(fields: [cicloId], references: [id])
  liquidacionId  Int? // set al quedar DESCONTADO: NO se cuenta dos veces
  liquidacion    LiquidacionNomina? @relation(fields: [liquidacionId], references: [id])
  estado         String   @default("PENDIENTE") // PENDIENTE | AUTORIZADO | DESCONTADO | ANULADO
  anuladoMotivo  String? // trazabilidad si se anula
  autorizadoById Int?
  autorizadoPor  Usuario? @relation("ValeAutorizadoPor", fields: [autorizadoById], references: [id])
  autorizadoAt   DateTime?
  creadoById     Int
  creadoPor      Usuario  @relation("ValeCreadoPor", fields: [creadoById], references: [id])
  createdAt      DateTime @default(now())

  @@index([empleadoId, estado])
  @@index([cicloId])
  @@index([fecha])
}

