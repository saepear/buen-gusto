{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/admin/caja/recibo/[pagoId]",
      "regex": "^/admin/caja/recibo/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPpagoId": "nxtPpagoId"
      },
      "namedRegex": "^/admin/caja/recibo/(?<nxtPpagoId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/mesero/mesa/[mesaId]",
      "regex": "^/mesero/mesa/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPmesaId": "nxtPmesaId"
      },
      "namedRegex": "^/mesero/mesa/(?<nxtPmesaId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/mesero/mesa/[mesaId]/nuevo",
      "regex": "^/mesero/mesa/([^/]+?)/nuevo(?:/)?$",
      "routeKeys": {
        "nxtPmesaId": "nxtPmesaId"
      },
      "namedRegex": "^/mesero/mesa/(?<nxtPmesaId>[^/]+?)/nuevo(?:/)?$"
    },
    {
      "page": "/ordenes/comanda/[pedidoId]",
      "regex": "^/ordenes/comanda/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPpedidoId": "nxtPpedidoId"
      },
      "namedRegex": "^/ordenes/comanda/(?<nxtPpedidoId>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
