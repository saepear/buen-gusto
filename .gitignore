# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/.next-prod/

# production
/build

# misc
.DS_Store
*.pem

# Bases de datos locales (datos reales del restaurante nunca van al repo)
/prisma/dev.db
/prisma/*.db
/prisma/*.bak*
*.sqlite
*.sqlite3

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Scripts temporales de verificación (pruebas de escenarios, nunca van al repo)
/scripts/tmp-*.ts
