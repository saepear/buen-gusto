# El Buen Gusto — variables de entorno (copia este archivo a `.env` y ajusta)

# Base de datos SQLite local (se crea con `npm run db:push`)
DATABASE_URL="file:./dev.db"

# Clave para firmar las cookies de sesión. OBLIGATORIA en producción con
# 32+ caracteres aleatorios. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="cámbiame-por-32-caracteres-aleatorios-o-más"
